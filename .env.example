# ==============================================================================
# REPOPILOT AI — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# Never commit real credentials or access tokens into version control.

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Browser-safe)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon Key (publicly safe; respects RLS policies)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Google Gemini API Key (optional for client-side testing; free tier available at https://aistudio.google.com)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# GitHub OAuth Application Client ID (public identifier)
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY VARIABLES (Supabase Edge Functions & Vault)
# DO NOT PREFIX WITH VITE_ — THESE MUST NEVER BE EXPOSED TO CLIENT BUNDLES!
# ------------------------------------------------------------------------------
# Supabase Service Role Key (full administrative access; used only in Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# GitHub OAuth Application Client Secret (used in server-side token exchange)
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# 32-character encryption secret for AES-256-GCM token encryption in Postgres
TOKEN_ENCRYPTION_SECRET=your_32_character_aes_secret_key!

# Optional Gemini API key for server-side generate-readme edge function
GEMINI_API_KEY=your_gemini_api_key_here
